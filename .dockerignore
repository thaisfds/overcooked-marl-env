# Ignore virtual environment
venv/
.venv/
env/

# Ignore large backup models & documents (do not copy 2.3GB into docker image)
Modelos Backup/
documentos POC/
*.zip
*.tar.gz
*.pt
*.pth

# Ignore heavy training results and logs
experiments/ray_results/
experiments/logs/
*.log

# Ignore git and ide configuration
.git/
.gitignore
.vscode/
.idea/

# Ignore python cache and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.pytest_cache/
